# Breadcrumb environment configuration
# Copy this file to .env and fill in your values

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/breadcrumb?retryWrites=true&w=majority

# Gemma / Ollama
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma3:12b

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# API
API_PORT=3001
API_HOST=0.0.0.0

# Web
VITE_API_URL=http://localhost:3001

# ElevenLabs (optional)
ELEVENLABS_API_KEY=
